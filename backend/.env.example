# ============================================================
# SchoolManager — Backend
# Exemple de configuration (copier vers .env et ajuster)
# ============================================================

# Clé secrète de signature des jetons JWT (obligatoire en production)
SECRET_KEY=changez-moi-une-longue-chaine-aleatoire-2026
# Durée de validité du jeton d'accès (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Hôte / port uvicorn
HOST=127.0.0.1
PORT=8000
# Nom de la base SQLite (dossier data/ à la racine de backend/)
DB_NAME=school.db
